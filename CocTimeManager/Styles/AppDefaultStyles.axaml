<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20" Background="#282C34">
            <StackPanel Spacing="8">
                <TextBlock Classes="h1" Text="Heading" />
                <Border Classes="card">
                    <TextBlock Classes="value accent" Text="62.5%" />
                </Border>
                <Button Classes="primary">Start &amp; track</Button>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource OdBlue}" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="#9DA5B4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#7F848E" />
    </Style>

    <Style Selector="TextBlock.value">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.accent">
        <Setter Property="Foreground" Value="{StaticResource OdGreen}" />
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style Selector="TextBlock.done">
        <Setter Property="Foreground" Value="{StaticResource OdGreen}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Image.icon">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <!-- Small round "i" badge that shows its ToolTip.Tip on hover -->
    <Style Selector="Border.info">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{StaticResource OdComment}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="ToolTip.ShowDelay" Value="0" />
        <Setter Property="ToolTip.Placement" Value="Right" />
    </Style>
    <Style Selector="Border.info > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{StaticResource OdComment}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.info:pointerover">
        <Setter Property="BorderBrush" Value="{StaticResource OdYellow}" />
    </Style>
    <Style Selector="Border.info:pointerover > TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OdYellow}" />
    </Style>
    <Style Selector="ProgressBar.upgrade">
        <Setter Property="Foreground" Value="{StaticResource OdGreen}" />
        <Setter Property="Background" Value="{StaticResource OdDarker}" />
        <Setter Property="Height" Value="14" />
        <Setter Property="MinHeight" Value="14" />
        <Setter Property="CornerRadius" Value="7" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="Background" Value="{StaticResource OdDarker}" />
        <Setter Property="BorderBrush" Value="{StaticResource OdBorder}" />
        <Setter Property="Foreground" Value="{StaticResource OdText}" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- "Update available" banner: card with a blue edge -->
    <Style Selector="Border.card.update">
        <Setter Property="BorderBrush" Value="{StaticResource OdBlue}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Collapsible card (drop-down section) -->
    <Style Selector="Expander.section">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource OdBlue}" />
        <Setter Property="Foreground" Value="{StaticResource OdBackground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#7DBFF3" />
        <Setter Property="Foreground" Value="{StaticResource OdBackground}" />
    </Style>
</Styles>
