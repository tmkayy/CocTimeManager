<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:CocTimeManager.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             x:Class="CocTimeManager.Views.MainView"
             Background="{StaticResource PrimaryBackground}"
             FontFamily="{StaticResource ContentControlThemeFontFamily}">
    <!-- The whole page scrolls; MainView.axaml.cs switches RootGrid between
         two columns (wide screens) and one stacked column (phones). -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="RootGrid" ColumnDefinitions="360, *" RowDefinitions="Auto" Margin="16" ColumnSpacing="16" RowSpacing="20">

        <!-- ============ Inputs ============ -->
        <StackPanel x:Name="InputsPanel" Grid.Column="0" Spacing="12">
                <!-- Shown when a newer release is out -->
                <Border x:Name="UpdateBanner" Classes="card update" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="UpdateStatus" Classes="hint" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="UpdateButton" Classes="primary" Content="Update" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Classes="h1" Text="New upgrade" />

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="label" Text="Name (optional)" />
                        <TextBox x:Name="NameBox" PlaceholderText="e.g. Archer Queen 95" />

                        <TextBlock Classes="label" Text="Full upgrade time" Margin="0,6,0,0" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <NumericUpDown x:Name="DaysInput" Minimum="0" Maximum="60" Value="0" Increment="1" FormatString="0" />
                                <TextBlock Classes="hint" Text="days" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <NumericUpDown x:Name="HoursInput" Minimum="0" Maximum="23" Value="0" Increment="1" FormatString="0" />
                                <TextBlock Classes="hint" Text="hours" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <NumericUpDown x:Name="MinutesInput" Minimum="0" Maximum="59" Value="0" Increment="1" FormatString="0" />
                                <TextBlock Classes="hint" Text="minutes" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <CheckBox x:Name="PotionCheck">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image Source="avares://CocTimeManager/icons/builder_potion.png" Classes="icon" />
                                    <TextBlock Text="Builder Potion" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                            <Border Classes="info"
                                    ToolTip.Tip="Builders work 10x faster while the potion is active. One potion lasts 1 hour and saves 9 hours of upgrade time. Enter the total real time it will stay active (e.g. 2h for two stacked potions).">
                                <TextBlock Text="i" />
                            </Border>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                              IsVisible="{Binding #PotionCheck.IsChecked}">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <NumericUpDown x:Name="PotionHoursInput" Minimum="0" Maximum="99" Value="1" Increment="1" FormatString="0" />
                                <TextBlock Classes="hint" Text="hours active" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <NumericUpDown x:Name="PotionMinutesInput" Minimum="0" Maximum="59" Value="0" Increment="5" FormatString="0" />
                                <TextBlock Classes="hint" Text="minutes active" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <CheckBox x:Name="BiteCheck">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image Source="avares://CocTimeManager/icons/builder_bite.png" Classes="icon" />
                                    <TextBlock Text="Builder Bite" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                            <Border Classes="info"
                                    ToolTip.Tip="Builders work 2x faster while a bite is active. One bite lasts 1 hour and saves 1 hour of upgrade time. Bites don't stack with a Builder Potion (no extra speed while the potion runs), so they're counted as used right after the potion ends. Enter the total real time they'll stay active (e.g. 3h for three bites).">
                                <TextBlock Text="i" />
                            </Border>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                              IsVisible="{Binding #BiteCheck.IsChecked}">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <NumericUpDown x:Name="BiteHoursInput" Minimum="0" Maximum="99" Value="1" Increment="1" FormatString="0" />
                                <TextBlock Classes="hint" Text="hours active" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <NumericUpDown x:Name="BiteMinutesInput" Minimum="0" Maximum="59" Value="0" Increment="5" FormatString="0" />
                                <TextBlock Classes="hint" Text="minutes active" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="label" Text="Time reductions" />
                            <Border Classes="info"
                                    ToolTip.Tip="Percentages are editable in case an event or your Gold Pass tier differs. Hammer Jam and Summer Jam never run at the same time, so they share one slot. Reductions stack multiplicatively: 20% + 50% = 1 - 0.8 × 0.5 = 60% total.">
                                <TextBlock Text="i" />
                            </Border>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                            <CheckBox Grid.Row="0" Grid.Column="0" x:Name="GoldPassCheck">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image Source="avares://CocTimeManager/icons/gold_pass.png" Classes="icon" />
                                    <TextBlock Text="Gold Pass" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                            <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="GoldPassPct" VerticalAlignment="Center"
                                           Minimum="0" Maximum="100" Value="20" Increment="5" FormatString="0'%'"
                                           IsEnabled="{Binding #GoldPassCheck.IsChecked}" />

                            <CheckBox Grid.Row="1" Grid.Column="0" x:Name="JamCheck">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image Source="avares://CocTimeManager/icons/hammer.png" Classes="icon" />
                                    <TextBlock Text="Hammer / Summer Jam" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="JamPct" VerticalAlignment="Center"
                                           Minimum="0" Maximum="100" Value="50" Increment="5" FormatString="0'%'"
                                           IsEnabled="{Binding #JamCheck.IsChecked}" />

                            <CheckBox Grid.Row="2" Grid.Column="0" x:Name="InactivityCheck">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image Source="avares://CocTimeManager/icons/villager.webp" Classes="icon" />
                                    <TextBlock Text="Inactivity Boost" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                            <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="InactivityPct" VerticalAlignment="Center"
                                           Minimum="0" Maximum="100" Value="50" Increment="5" FormatString="0'%'"
                                           IsEnabled="{Binding #InactivityCheck.IsChecked}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Collapsed by default to save space -->
                <Expander x:Name="SyncExpander" Classes="section">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="label" Text="Sync with another device" />
                            <Border Classes="info"
                                    ToolTip.Tip="Both devices on the same Wi-Fi: press Show code on one and type that code on the other with Enter code. Both lists are merged both ways: nothing is lost, deleted upgrades stay deleted, and the newest village import wins. If it can't find the other device, swap which one shows the code (a firewall may be blocking). Not on the same Wi-Fi? Use Copy code / Paste code and send the code yourself.">
                                <TextBlock Text="i" />
                            </Border>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="8">
                        <!-- Idle -->
                        <Grid x:Name="SyncIdlePanel" ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" x:Name="ShowSyncCodeButton" Content="Show code" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Column="1" x:Name="EnterSyncCodeButton" Content="Enter code" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </Grid>

                        <!-- Hosting: big code + countdown -->
                        <StackPanel x:Name="SyncHostPanel" Spacing="4" IsVisible="False">
                            <TextBlock x:Name="SyncCodeText" FontSize="44" FontWeight="Bold" LetterSpacing="12"
                                       HorizontalAlignment="Center" Classes="accent" />
                            <TextBlock x:Name="SyncHostHint" Classes="hint" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="CancelSyncButton" Content="Cancel" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Joining: type the code -->
                        <Grid x:Name="SyncJoinPanel" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="False">
                            <TextBox Grid.Column="0" x:Name="SyncCodeInput" PlaceholderText="4-digit code" MaxLength="4"
                                     FontSize="20" HorizontalContentAlignment="Center" TextInputOptions.ContentType="Digits" />
                            <Button Grid.Column="1" x:Name="JoinSyncButton" Classes="primary" Content="Sync" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" x:Name="CancelJoinButton" Content="✕" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
                        </Grid>

                        <!-- Fallback: send the long code yourself -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" x:Name="CopySyncButton" Content="Copy code" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Grid.Column="1" x:Name="PasteSyncButton" Content="Paste code" FontSize="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander x:Name="SettingsExpander" Classes="section">
                    <Expander.Header>
                        <TextBlock Classes="label" Text="Settings" />
                    </Expander.Header>
                    <StackPanel Spacing="10">
                    <!-- Desktop only (shown from code when autostart is supported) -->
                    <StackPanel x:Name="AutostartRow" Orientation="Horizontal" Spacing="6" IsVisible="False">
                        <CheckBox x:Name="AutostartCheck" Content="Start at login" />
                        <Border Classes="info"
                                ToolTip.Tip="Starts hidden in the system tray when you log in, so you get notified when upgrades finish without opening the app. Closing the window keeps it running in the tray; use Quit in the tray menu to exit.">
                            <TextBlock Text="i" />
                        </Border>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="VersionText" Classes="label" />
                            <TextBlock x:Name="UpdateCheckStatus" Classes="hint" TextWrapping="Wrap" IsVisible="False" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="CheckUpdatesButton" Content="Check for updates" VerticalAlignment="Center" />
                    </Grid>
                    </StackPanel>
                </Expander>
        </StackPanel>

        <!-- ============ Results + tracker ============ -->
        <Grid x:Name="ResultsPanel" Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
            <TextBlock Grid.Row="0" Classes="h1" Text="Result" />

            <Border Grid.Row="1" Classes="card">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Local time now" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NowText" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Done at" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FinishText" Classes="value" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Time it'll take" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DurationText" Classes="value" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Total reduction" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="ReductionText" Classes="value accent" VerticalAlignment="Center" />
                        <Border x:Name="BreakdownInfo" Classes="info" ToolTip.Tip="Enter an upgrade time">
                            <TextBlock Text="i" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="h1" Text="Tracked upgrades" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="ImportButton" Content="Import village"
                        ToolTip.Tip="In the game: Settings → More Settings → Export village data (copies it to the clipboard). Then press this to add every running upgrade, lab research and pet upgrade. Importing again updates them; ones that are no longer running are removed." />
                <Button Grid.Column="2" x:Name="TrackButton" Classes="primary" Content="Start &amp; track" />
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                <CheckBox x:Name="BuilderBaseCheck" Content="Builder Base upgrades" />
                <Border Classes="info"
                        ToolTip.Tip="Off: imported Builder Base upgrades are hidden and don't notify you when they finish. They're still imported and synced, so turning this back on shows them again.">
                    <TextBlock Text="i" />
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="4" x:Name="ImportStatus" Classes="hint" TextWrapping="Wrap" IsVisible="False" />

            <ItemsControl Grid.Row="5" x:Name="TrackedList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:TrackedUpgrade">
                        <Border Classes="card" Padding="12,10">
                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FinishText}" Classes="hint" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding RemainingText}" VerticalAlignment="Center"
                                       Classes.done="{Binding IsDone}" />
                            <Button Grid.Column="2" Content="✕" Click="RemoveTracked_Click"
                                    VerticalAlignment="Center" Padding="8,2" />
                            <ProgressBar Grid.Row="1" Grid.Column="0" Classes="upgrade"
                                         Minimum="0" Maximum="100" Value="{Binding Progress}" VerticalAlignment="Center" />
                            <!-- Beside the bar rather than on it: readable whatever the fill -->
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="hint" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Text="{Binding Progress, StringFormat={}{0:0.0}%}" />
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
