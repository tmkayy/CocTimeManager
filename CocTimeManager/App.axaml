<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CocTimeManager.App"
             RequestedThemeVariant="Dark">

    <!-- Resources come before Styles: the styles reference these colours while loading -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- Used by Styles/AppDefaultStyles.axaml through DynamicResource, so switching theme applies at once.
                 Dark is One Dark. Light is warm paper and lavender. The docs site uses the same colours
                 (docs/stylesheets/extra.css). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="OdBackground" Color="#282C34" />
                    <SolidColorBrush x:Key="OdDarker" Color="#21252B" />
                    <SolidColorBrush x:Key="OdCard" Color="#2F343F" />
                    <SolidColorBrush x:Key="OdCardHover" Color="#353B47" />
                    <SolidColorBrush x:Key="OdBorder" Color="#3E4451" />
                    <SolidColorBrush x:Key="OdText" Color="#ABB2BF" />
                    <SolidColorBrush x:Key="OdComment" Color="#5C6370" />
                    <SolidColorBrush x:Key="OdBlue" Color="#61AFEF" />
                    <SolidColorBrush x:Key="OdPrimaryHover" Color="#7DBFF3" />
                    <SolidColorBrush x:Key="OdGreen" Color="#98C379" />
                    <SolidColorBrush x:Key="OdYellow" Color="#E5C07B" />
                    <SolidColorBrush x:Key="OdRed" Color="#E06C75" />
                    <SolidColorBrush x:Key="OdPurple" Color="#C678DD" />
                    <SolidColorBrush x:Key="OdLabel" Color="#9DA5B4" />
                    <SolidColorBrush x:Key="OdHint" Color="#7F848E" />
                    <SolidColorBrush x:Key="PrimaryBackground" Color="#282C34" />
                    <SolidColorBrush x:Key="CardBackground" Color="#2F343F" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#2F343F" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#353B47" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#353B47" />
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="#2F343F" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#262A31" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#7F848E" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#262A31" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#3E4451" />
                    <SolidColorBrush x:Key="RepeatButtonBackgroundDisabled" Color="#262A31" />
                    <SolidColorBrush x:Key="RepeatButtonBorderBrushDisabled" Color="#3E4451" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OdBackground" Color="#FFF7EA" />
                    <SolidColorBrush x:Key="OdDarker" Color="#D5CDC0" />
                    <SolidColorBrush x:Key="OdCard" Color="#ECE3D6" />
                    <SolidColorBrush x:Key="OdCardHover" Color="#E6DDD0" />
                    <SolidColorBrush x:Key="OdBorder" Color="#C5BDB0" />
                    <SolidColorBrush x:Key="OdText" Color="#100A03" />
                    <SolidColorBrush x:Key="OdComment" Color="#5B5449" />
                    <SolidColorBrush x:Key="OdBlue" Color="#4845A5" />
                    <SolidColorBrush x:Key="OdPrimaryHover" Color="#5759A6" />
                    <SolidColorBrush x:Key="OdGreen" Color="#356B22" />
                    <SolidColorBrush x:Key="OdYellow" Color="#8A6A10" />
                    <SolidColorBrush x:Key="OdRed" Color="#B03A48" />
                    <SolidColorBrush x:Key="OdPurple" Color="#7A3FA0" />
                    <SolidColorBrush x:Key="OdLabel" Color="#5B5449" />
                    <SolidColorBrush x:Key="OdHint" Color="#5B5449" />
                    <SolidColorBrush x:Key="PrimaryBackground" Color="#FFF7EA" />
                    <SolidColorBrush x:Key="CardBackground" Color="#ECE3D6" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#ECE3D6" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#E6DDD0" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#E6DDD0" />
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="#ECE3D6" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#E6DDD0" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#968E82" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#E6DDD0" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#C5BDB0" />
                    <SolidColorBrush x:Key="RepeatButtonBackgroundDisabled" Color="#E6DDD0" />
                    <SolidColorBrush x:Key="RepeatButtonBorderBrushDisabled" Color="#C5BDB0" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Expanders look like the other cards -->
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />

            <!-- Checkboxes: no tick mark, a ticked box is just solid colour -->
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" Color="Transparent" />

            <!-- Maple Mono everywhere: overrides the font FluentTheme uses for controls -->
            <FontFamily x:Key="ContentControlThemeFontFamily">avares://CocTimeManager/fonts#Maple Mono</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Palettes for the built-in controls (text boxes, number inputs, buttons, checkboxes, ...) -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#61AFEF"
                                       RegionColor="#282C34"
                                       ErrorText="#E06C75"
                                       BaseHigh="#ABB2BF"
                                       BaseMediumHigh="#9DA5B4"
                                       BaseMedium="#7F848E"
                                       BaseMediumLow="#5C6370"
                                       BaseLow="#3E4451"
                                       AltHigh="#21252B"
                                       AltMediumHigh="#21252B"
                                       AltMedium="#21252B"
                                       AltMediumLow="#21252B"
                                       AltLow="#21252B"
                                       ChromeHigh="#4B5263"
                                       ChromeMedium="#3A3F4B"
                                       ChromeMediumLow="#2C313A"
                                       ChromeLow="#21252B"
                                       ChromeAltLow="#ABB2BF"
                                       ChromeGray="#5C6370"
                                       ChromeWhite="#ABB2BF"
                                       ChromeDisabledHigh="#3E4451"
                                       ChromeDisabledLow="#5C6370"
                                       ListLow="#2C313A"
                                       ListMedium="#3E4451" />
                <ColorPaletteResources x:Key="Light"
                                       Accent="#4845A5"
                                       RegionColor="#FFF7EA"
                                       ErrorText="#B03A48"
                                       BaseHigh="#100A03"
                                       BaseMediumHigh="#2A241B"
                                       BaseMedium="#5B5449"
                                       BaseMediumLow="#968E82"
                                       BaseLow="#C5BDB0"
                                       AltHigh="#FFFBF3"
                                       AltMediumHigh="#FFFBF3"
                                       AltMedium="#FFFBF3"
                                       AltMediumLow="#FFFBF3"
                                       AltLow="#FFFBF3"
                                       ChromeHigh="#C5BDB0"
                                       ChromeMedium="#D5CDC0"
                                       ChromeMediumLow="#E6DDD0"
                                       ChromeLow="#ECE3D6"
                                       ChromeAltLow="#100A03"
                                       ChromeGray="#968E82"
                                       ChromeWhite="#FFFBF3"
                                       ChromeDisabledHigh="#D5CDC0"
                                       ChromeDisabledLow="#968E82"
                                       ListLow="#E6DDD0"
                                       ListMedium="#D5CDC0" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="Styles/AppDefaultStyles.axaml"></StyleInclude>
    </Application.Styles>
</Application>
