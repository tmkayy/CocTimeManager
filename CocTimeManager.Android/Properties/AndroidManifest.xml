<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
    <!-- Android 13+: ask the user before showing notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact alarms so the notification fires on the second the upgrade finishes -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Alarms are wiped on reboot; re-schedule them -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Wi-Fi sync with a 4-digit code: local network sockets, and a multicast lock so the phone
         receives the other device's broadcast when it is the one showing the code -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- In-app updates: hand the downloaded APK to the system installer (the user confirms) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application android:label="CoC Upgrade Timer" android:icon="@drawable/icon">
        <provider android:name="androidx.core.content.FileProvider"
                  android:authorities="com.tmk.coctimemanager.updates"
                  android:exported="false"
                  android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
